products = {
    1: {"name": "Laptop", "price": 55000, "stock": 5},
    2: {"name": "Smartphone", "price": 18000, "stock": 10},
    3: {"name": "Headphones", "price": 1500, "stock": 15},
    4: {"name": "Keyboard", "price": 800, "stock": 20},
    5: {"name": "Mouse", "price": 500, "stock": 25}
}

cart = []


def show_products():
    print("\n========== PRODUCTS ==========")
    for product_id, product in products.items():
        print(
            f"{product_id}. {product['name']} "
            f"- ₹{product['price']} "
            f"(Stock: {product['stock']})"
        )


def search_product():
    keyword = input("\nEnter product name to search: ").lower()

    found = False

    for product_id, product in products.items():
        if keyword in product["name"].lower():
            print(
                f"{product_id}. {product['name']} "
                f"- ₹{product['price']} "
                f"(Stock: {product['stock']})"
            )
            found = True

    if not found:
        print("Product not found.")


def add_to_cart():
    show_products()

    try:
        product_id = int(input("\nEnter product ID: "))
        quantity = int(input("Enter quantity: "))

        if product_id not in products:
            print("Invalid product ID.")
            return

        product = products[product_id]

        if quantity <= 0:
            print("Quantity must be greater than 0.")
        elif quantity > product["stock"]:
            print("Sorry, not enough stock available.")
        else:
            cart.append({
                "id": product_id,
                "name": product["name"],
                "price": product["price"],
                "quantity": quantity
            })

            product["stock"] -= quantity
            print(f"{quantity} x {product['name']} added to cart.")

    except ValueError:
        print("Please enter a valid number.")


def view_cart():
    if not cart:
        print("\nYour cart is empty.")
        return

    print("\n========== YOUR CART ==========")

    total = 0

    for item in cart:
        amount = item["price"] * item["quantity"]
        total += amount

        print(
            f"{item['name']} | "
            f"₹{item['price']} x {item['quantity']} "
            f"= ₹{amount}"
        )

    print("-------------------------------")
    print(f"Total Amount: ₹{total}")


def place_order():
    if not cart:
        print("\nYour cart is empty.")
        return

    name = input("\nEnter customer name: ")
    phone = input("Enter phone number: ")
    address = input("Enter delivery address: ")

    total = sum(
        item["price"] * item["quantity"]
        for item in cart
    )

    print("\n========== ORDER CONFIRMATION ==========")
    print(f"Customer : {name}")
    print(f"Phone    : {phone}")
    print(f"Address  : {address}")
    print(f"Total    : ₹{total}")

    payment = input("\nSelect payment method (UPI/Cash/Card): ")

    print("\nOrder placed successfully! 🎉")
    print(f"Payment Method: {payment}")
    print("Thank you for shopping with us.")

    cart.clear()


def main():
    while True:
        print("\n================================")
        print("       E-BUSINESS STORE")
        print("================================")
        print("1. View Products")
        print("2. Search Product")
        print("3. Add Product to Cart")
        print("4. View Cart")
        print("5. Place Order")
        print("6. Exit")

        choice = input("\nEnter your choice: ")

        if choice == "1":
            show_products()

        elif choice == "2":
            search_product()

        elif choice == "3":
            add_to_cart()

        elif choice == "4":
            view_cart()

        elif choice == "5":
            place_order()

        elif choice == "6":
            print("\nThank you for visiting our E-Business Store!")
            break

        else:
            print("Invalid choice. Please try again.")


main()
